# ══════════════════════════════════════════════════════════════
#  Go Nature Farms Backend - Environment Variables
#  Copy this file to .env for local development
# ══════════════════════════════════════════════════════════════

# ── Server Configuration ───────────────────────────────────────
PORT=8080

# ── PostgreSQL Database (Render provides these automatically) ──
# For local development, use the values below:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gonaturefarms
DB_USER=postgres
DB_PASSWORD=918252

# ── JWT Configuration ──────────────────────────────────────────
JWT_SECRET=GoNatureFarms_SuperSecret_JWT_Key_2026_ChangeInProd!
JWT_EXPIRES_IN=7d

# ── CORS Configuration ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://gonaturefarms-frontend-fvn3mbf18-gonatuefarms.vercel.app,http://localhost:5173,http://localhost:5174

# ── Default Admin Credentials (fallback if no admin in DB) ─────
ADMIN_DEFAULT_USER=Vishnu
ADMIN_DEFAULT_PASS=918252

# ── File Upload Configuration ───────────────────────────────────
UPLOAD_DIR=./uploads
