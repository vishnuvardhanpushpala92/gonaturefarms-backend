{
  "$schema": "https://json.schemastore.org/railway",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "APP_FRONTEND_URL": "https://gonaturefarms-frontend.netlify.app,http://localhost:5173",
    "SPRING_PROFILES_ACTIVE": "production"
  }
}
